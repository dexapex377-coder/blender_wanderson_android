<!-- Added with addContentView() on top of the NativeActivity's own surface
     rather than setContentView(), which would replace it. Not clickable, so
     Blender's input still reaches the surface underneath; only the Skip
     button takes touches while this is up. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bl_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Compiling shaders"
            android:textColor="@color/bl_text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/warmup_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:layout_marginTop="20dp"
            android:progressDrawable="@drawable/warmup_progress" />

        <TextView
            android:id="@+id/warmup_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="0/0"
            android:textColor="@color/bl_text_secondary"
            android:textSize="15sp" />

        <Button
            android:id="@+id/warmup_skip"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="32dp"
            android:background="@drawable/launch_button"
            android:minWidth="160dp"
            android:text="Skip"
            android:textAllCaps="false"
            android:textColor="@color/bl_text_primary"
            android:textSize="16sp" />

    </LinearLayout>

</FrameLayout>
