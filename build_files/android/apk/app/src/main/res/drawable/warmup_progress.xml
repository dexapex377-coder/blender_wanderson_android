<!-- Layer list rather than progressTint alone: the default horizontal style
     draws its track from the theme, which on this device is a light colour and
     reads as a bright bar on a dark screen. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="@color/bl_progress_track" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <solid android:color="@color/bl_orange" />
                <corners android:radius="4dp" />
            </shape>
        </clip>
    </item>
</layer-list>
